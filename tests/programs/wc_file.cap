package safe
module wc_file
use sys::system
use sys::console

fn count_text(c: Console, s: string) -> i32 {
  let bytes = s.len()
  let words = s.count_words_ascii()
  let lines = s.count_newlines()
  c.assert(lines == 8 && words == 19 && bytes == 126)
  c.print_i32(lines)
  c.print(" ")
  c.print_i32(words)
  c.print(" ")
  c.print_i32(bytes)
  c.println("")
  return 0
}

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let args = rc.mint_args()
  try let path = args.at(1) else {
    c.println("usage: wc <path>")
    return 1
  }
  let rfs = rc.mint_readfs("./")
  let code = match rfs.read_to_string_default(path) {
    Ok(s) => {
      count_text(c, s)
    }
    Err(e) => {
      c.println("read err")
      1
    }
  }

  return code
}
