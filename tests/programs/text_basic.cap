package safe
module text_basic
use sys::system
use sys::string

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let alloc = rc.mint_alloc_default()
  let text = string::text_new(alloc)
  text.push_str("hi").ok()
  text.push_byte('!').ok()
  let view = text.as_string()
  c.assert(view.eq("hi!"))
  c.assert(text.to_string().ok().eq("hi!"))
  text.free(alloc)
  c.println("text basic ok")
  return 0
}
