package safe
module text_basic
use sys::system
use sys::string

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let text = string::text_new()
  defer text.free()
  try text.push_str("hi") else {
    panic()
  }
  try text.push_byte('!') else {
    panic()
  }
  let view = text.as_string()
  c.assert(view.eq("hi!"))
  try let owned = text.copy_string() else {
    c.assert(false)
    return 1
  }
  c.assert(owned.eq("hi!"))
  c.println("text basic ok")
  return 0
}
