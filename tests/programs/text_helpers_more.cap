package safe
module text_helpers_more
use sys::system
use sys::string
use sys::vec

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let text = string::text_new()
  defer text.free()
  try text.push_str("hi") else {
    panic()
  }
  try text.push_byte('\n') else {
    panic()
  }
  try text.push_str("ok") else {
    panic()
  }
  try let prefix = text.slice_range(0, 2) else {
    c.assert(false)
    return 1
  }
  c.assert(prefix.eq("hi"))
  let v = vec::new<u8>()
  defer v.free()
  try v.push('!') else {
    panic()
  }
  try text.extend_vec(v) else {
    panic()
  }
  try let owned = text.copy_string() else {
    c.assert(false)
    return 1
  }
  c.assert(owned.eq("hi\nok!"))
  try let t2 = string::text_from("cap") else {
    panic()
  }
  defer t2.free()
  try let owned2 = t2.copy_string() else {
    c.assert(false)
    return 1
  }
  c.assert(owned2.eq("cap"))
  try let t3 = "owned".copy_text() else {
    panic()
  }
  defer t3.free()
  try let owned3 = t3.copy_string() else {
    c.assert(false)
    return 1
  }
  c.assert(owned3.eq("owned"))
  c.println("text helpers ok")
  return 0
}
