package safe
module text_to_string
use sys::system
use sys::string

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let alloc = rc.mint_alloc_default()
  let text = string::text_new(alloc)
  text.push_byte('h').ok()
  text.push_byte('i').ok()
  let s = text.to_string().ok()
  c.println(s)
  text.free(alloc)
  return 0
}
