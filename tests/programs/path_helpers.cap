package safe
module path_helpers

use sys::system
use sys::path

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()

  try let clean = path::clean_relative("/site/./docs//index.html") else {
    c.assert(false)
    return 1
  }
  c.assert(clean.eq("site/docs/index.html"))
  let Err(path_err) = path::clean_relative("../etc/passwd") else {
    c.assert(false)
    return 1
  }

  let parts = path::segments_view("site/docs/index.html")
  defer parts.free()
  c.assert(parts.len() == 3)
  c.assert(parts.get_or(0, "").eq("site"))
  c.assert(parts.get_or(1, "").eq("docs"))
  c.assert(parts.get_or(2, "").eq("index.html"))
  c.assert(path::basename_view("site/docs/index.html").eq("index.html"))
  c.assert(path::dirname_view("site/docs/index.html").eq("site/docs"))

  let joined = path::join("site/docs", "index.html")
  c.assert(joined.eq("site/docs/index.html"))

  c.println("path ok")
  return 0
}
