package safe
module vec_search_helpers
use sys::system

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let alloc = rc.mint_alloc_default()
  let v = alloc.vec_i32_new()
  v.push(1).ok()
  v.push(2).ok()
  v.push(1).ok()
  c.assert(v.contains(2))
  c.assert(!v.contains(3))
  c.assert(v.count(1) == 2)
  match (v.index_of(1)) {
    Ok(i) => { c.assert(i == 0) }
    Err(_) => { c.assert(false); return 1 }
  }
  match (v.last_index_of(1)) {
    Ok(i) => { c.assert(i == 2) }
    Err(_) => { c.assert(false); return 1 }
  }
  match (v.first()) {
    Ok(x) => { c.assert(x == 1) }
    Err(_) => { c.assert(false); return 1 }
  }
  match (v.last()) {
    Ok(x) => { c.assert(x == 1) }
    Err(_) => { c.assert(false); return 1 }
  }
  v.swap(0, 1).ok()
  match (v.first()) {
    Ok(x) => { c.assert(x == 2) }
    Err(_) => { c.assert(false); return 1 }
  }
  c.assert(v.get_or(1, 99) == 1)
  c.assert(v.get_or(99, 77) == 77)
  let bytes = alloc.vec_u8_new()
  bytes.push('h').ok()
  bytes.push('i').ok()
  c.assert(bytes.to_string().ok().eq("hi"))
  alloc.vec_i32_free(v)
  alloc.vec_u8_free(bytes)
  c.println("vec search ok")
  return 0
}
