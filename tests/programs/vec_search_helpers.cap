package safe
module vec_search_helpers
use sys::system
use sys::vec

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let v = vec::new<i32>()
  defer v.free()
  try v.push(1) else {
    panic()
  }
  try v.push(2) else {
    panic()
  }
  try v.push(1) else {
    panic()
  }
  c.assert(v.contains(2))
  c.assert(!v.contains(3))
  c.assert(v.count(1) == 2)
  match (v.index_of(1)) {
    Ok(i) => { c.assert(i == 0) }
    Err(_) => { c.assert(false); return 1 }
  }
  match (v.last_index_of(1)) {
    Ok(i) => { c.assert(i == 2) }
    Err(_) => { c.assert(false); return 1 }
  }
  match (v.first()) {
    Ok(x) => { c.assert(x == 1) }
    Err(_) => { c.assert(false); return 1 }
  }
  match (v.last()) {
    Ok(x) => { c.assert(x == 1) }
    Err(_) => { c.assert(false); return 1 }
  }
  try v.swap(0, 1) else {
    panic()
  }
  match (v.first()) {
    Ok(x) => { c.assert(x == 2) }
    Err(_) => { c.assert(false); return 1 }
  }
  c.assert(v.get_or(1, 99) == 1)
  c.assert(v.get_or(99, 77) == 77)
  let bytes = vec::new<u8>()
  defer bytes.free()
  try bytes.push('h') else {
    panic()
  }
  try bytes.push('i') else {
    panic()
  }
  let view = bytes.as_string()
  c.assert(view.eq("hi"))
  try let s = bytes.copy_string() else {
    c.assert(false)
    return 1
  }
  c.assert(s.eq("hi"))
  c.println("vec search ok")
  return 0
}
