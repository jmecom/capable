package safe
module try_let
use sys::system

fn parse(flag: bool) -> Result<i32, string> {
  if (flag) {
    return Ok(11)
  }
  return Err("bad")
}

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()

  try let n = parse(true) else {
    return 1
  }
  c.assert(n == 11)

  let fallback = match parse(false) {
    Ok(found) => { found }
    Err(_) => {
      try let found = parse(true) else {
        return 2
      }
      found
    }
  }
  c.assert(fallback == 11)
  c.println("try let ok")
  return 0
}
