package safe
module text_push_safe
use sys::system
use sys::string

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let alloc = rc.mint_alloc_default()
  let text = string::text_new(alloc)
  try text.push_byte('\x00') else {
    panic()
  }
  try text.push_byte('\x07') else {
    panic()
  }
  let v = alloc.vec_u8_new()
  try v.push('\t') else {
    panic()
  }
  let slice = v.as_slice()
  try text.extend_slice(slice) else {
    panic()
  }
  let len = text.len()
  c.assert(len == 3)
  c.assert(!text.is_empty())
  if (len == 3) {
    c.println("push ok")
  } else {
    c.println("push bad")
  }
  alloc.vec_u8_free(v)
  text.free(alloc)
  return 0
}
