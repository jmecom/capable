package safe
module text_push_safe
use sys::system
use sys::string

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let alloc = rc.mint_alloc_default()
  let text = string::text_new(alloc)
  text.push_byte('\x00').ok()
  text.push_byte('\x07').ok()
  let v = alloc.vec_u8_new()
  v.push('\t').ok()
  let slice = v.as_slice()
  text.extend_slice(slice).ok()
  let len = text.len()
  c.assert(len == 3)
  c.assert(!text.is_empty())
  if (len == 3) {
    c.println("push ok")
  } else {
    c.println("push bad")
  }
  alloc.vec_u8_free(v)
  text.free(alloc)
  return 0
}
