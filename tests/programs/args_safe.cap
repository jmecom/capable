package safe
module args_safe
use sys::system

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let args = rc.mint_args()
  let n = args.len()
  c.assert(n >= 1)
  if (n < 1) {
    c.println("args bad")
    return 1
  }
  let s = args.at(0).ok()
  let m = s.len()
  c.assert(m >= 0)
  if (m >= 0) {
    c.println("args ok")
  }
  return 0
}
