package safe
module wc_stdin
use sys::system

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let stdin = rc.mint_stdin()
  let code = match stdin.read_to_string_default() {
    Ok(s) => {
      let bytes = s.len()
      let words = s.count_words_ascii()
      let lines = s.count_newlines()
      c.assert(lines == 0 && words == 0 && bytes == 0)
      c.print_i32(lines)
      c.print(" ")
      c.print_i32(words)
      c.print(" ")
      c.print_i32(bytes)
      c.println("")
      0
    }
    Err(e) => {
      c.println("stdin err")
      1
    }
  }
  return code
}
