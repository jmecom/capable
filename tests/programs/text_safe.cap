package safe
module text_safe
use sys::system
use sys::string

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let text = string::text_new()
  try text.push_byte('a') else {
    panic()
  }
  try text.push_byte('b') else {
    panic()
  }
  try text.push_byte('c') else {
    panic()
  }
  let slice = text.as_slice()
  let len = slice.len()
  c.assert(len == 3)
  if (len == 3) {
    c.println("text ok")
  } else {
    c.println("text bad")
  }
  text.free()
  return 0
}
