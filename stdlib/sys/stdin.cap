/// Stdin access.
package safe
module sys::stdin

use sys::io
use sys::buffer

/// Capability for stdin.
pub capability struct Stdin

impl Stdin {
  /// Read stdin into a string.
  pub fn read_to_string(self: &Stdin, alloc: buffer::Alloc) -> Result<string, io::IoErr> {
    return Err(io::IoErr::IoError)
  }

  /// Read stdin into a string using the process default allocator.
  pub fn read_to_string_default(self: &Stdin) -> Result<string, io::IoErr> {
    return self.read_to_string(buffer::default_alloc())
  }
}
