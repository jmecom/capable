/// Option enum and helpers.
package safe
module sys::option

/// Optional value.
pub enum Option<T> {
  /// Some value.
  Some(T),
  /// No value.
  None
}

impl<T> Option<T> {
  /// True if Some.
  pub fn is_some(self) -> bool {
    return match self {
      Option::Some(_) => { true }
      Option::None => { false }
    }
  }

  /// True if None.
  pub fn is_none(self) -> bool {
    return match self {
      Option::Some(_) => { false }
      Option::None => { true }
    }
  }

  /// Return the inner value or a default.
  pub fn unwrap_or(self, default: T) -> T {
    return match self {
      Option::Some(val) => { val }
      Option::None => { default }
    }
  }

  /// Unwrap the inner value or panic.
  pub fn unwrap(self) -> T {
    return match self {
      Option::Some(val) => { val }
      Option::None => { panic() }
    }
  }
}
