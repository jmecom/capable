package safe
module uniq
use sys::system
use sys::console
use sys::stdin
use sys::io
use sys::vec

fn should_print(lines: Vec<string>, i: i32) -> bool {
  if (i == 0) {
    return true
  }
  let curr = lines.get_or(i, "")
  let prev = lines.get_or(i - 1, "")
  return prev != curr
}

fn run(c: Console, input: Stdin) -> Result<unit, io::IoErr> {
  let contents = input.read_to_string()?
  let lines = contents.lines_view()
  let n = lines.len()
  for i in 0..n {
    if (should_print(lines, i)) {
      let line = lines.get_or(i, "")
      c.println(line)
    }
  }
  lines.free()
  return Ok(())
}

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let input = rc.mint_stdin()
  try run(c, input) else {
    c.println("error reading input")
    return 1
  }
  return 0
}
