package safe
module how_to_string
use sys::system
use sys::console
use sys::buffer

fn demo_string_view(c: Console) -> unit {
  let s = " hello,world \n"
  let trimmed = s.trim_view()
  c.println("-- string view --")
  c.println(trimmed)
  c.println("len:")
  c.println_i32(trimmed.len())

  match (trimmed.split_once_view(',')) {
    Ok(parts) => {
      c.println(parts.left)
      c.println(parts.right)
    }
    Err(_) => { c.println("comma not found") }
  }

  let words = trimmed.split_view_default(',')
  c.println("split count:")
  c.println_i32(words.len())
  c.println(words.get_or(0, ""))
  c.println(words.get_or(1, ""))
  words.free()
}

fn demo_text_builder(c: Console) -> unit {
  c.println("-- Text builder --")
  let t = buffer::text_new_default()
  t.push_str("hello") else {
    panic()
  }
  t.push_byte(' ') else {
    panic()
  }
  t.append("text") else {
    panic()
  }
  c.println(t.slice_range(0, 5).ok())
  c.println(t.to_string().ok())
  t.free_default()

  let t2 = buffer::text_from_default("owned").ok()
  c.println(t2.to_string().ok())
  t2.free_default()

  c.println("a".concat_default("b").ok())
}

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  demo_string_view(c)
  demo_text_builder(c)
  return 0
}
