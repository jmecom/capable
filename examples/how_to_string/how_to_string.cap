package safe
module how_to_string
use sys::system
use sys::console
use sys::string

fn demo_string_view(c: Console) -> unit {
  let s = " hello,world \n"
  let trimmed = s.trim_view()
  c.println("-- string view --")
  c.println(trimmed)
  c.println("len:")
  c.println_i32(trimmed.len())

  try let parts = trimmed.split_once_view(',') else {
    c.println("comma not found")
    return
  }
  c.println(parts.left)
  c.println(parts.right)

  let words = trimmed.split_view(',')
  defer words.free()
  c.println("split count:")
  c.println_i32(words.len())
  c.println(words.get_or(0, ""))
  c.println(words.get_or(1, ""))
}

fn demo_text_builder(c: Console) -> unit {
  c.println("-- Text builder --")
  let t = string::text_new()
  defer t.free()
  try t.push_str("hello") else {
    panic()
  }
  try t.push_byte(' ') else {
    panic()
  }
  try t.append("text") else {
    panic()
  }
  try let head = t.slice_range(0, 5) else {
    panic()
  }
  c.println(head)
  try let owned = t.copy_string() else {
    panic()
  }
  c.println(owned)

  try let t2 = string::text_from("owned") else {
    panic()
  }
  defer t2.free()
  try let owned2 = t2.copy_string() else {
    panic()
  }
  c.println(owned2)

  try let joined = "a".concat("b") else {
    panic()
  }
  c.println(joined)
}

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  demo_string_view(c)
  demo_text_builder(c)
  return 0
}
