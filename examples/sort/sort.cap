package safe
module sort
use sys::system
use sys::console
use sys::stdin
use sys::io
use sys::vec

// Compare lines at indices i and j
fn line_lt(lines: Vec<string>, i: i32, j: i32) -> bool {
  let line_i = lines.get_or(i, "")
  let line_j = lines.get_or(j, "")
  return line_i.compare(line_j) < 0
}

// Insertion sort on indices
fn sort_indices(lines: Vec<string>, indices: Vec<i32>) -> unit {
  let n = indices.len()
  for i in 1..n {
    let j = i
    while (j > 0) {
      let curr_idx = indices.get_or(j, 0)
      let prev_idx = indices.get_or(j - 1, 0)
      if (line_lt(lines, curr_idx, prev_idx)) {
        try indices.swap(j, j - 1) else {
          panic()
        }
        j = j - 1
      } else {
        break
      }
    }
  }
}

fn run(c: Console, input: Stdin) -> Result<unit, io::IoErr> {
  let contents = input.read_to_string()?
  let lines = contents.lines_view()
  defer lines.free()
  let n = lines.len()

  // Create index array [0, 1, 2, ...]
  let indices = vec::new<i32>()
  defer indices.free()
  for i in 0..n {
    try indices.push(i) else {
      panic()
    }
  }

  sort_indices(lines, indices)

  // Print lines in sorted order (skip empty lines)
  for idx in indices {
    let line = lines.get_or(idx, "")
    if (line.len() > 0) {
      c.println(line)
    }
  }
  return Ok(())
}

pub fn main(rc: RootCap) -> i32 {
  let c = rc.mint_console()
  let input = rc.mint_stdin()
  try run(c, input) else {
    c.println("error reading input")
    return 1
  }
  return 0
}
